# All settings are optional. See README.md for details.

# Secrets: generated on first start and stored in UPLOAD_FOLDER/.securefilehub when not set
# SECRET_KEY=
# TOTP_SECRET=
# Comma-separated, 6-64 characters each (letters, digits, dashes). Each code works once.
# BACKUP_CODES=

# UPLOAD_FOLDER=uploads
# TIMEZONE=Europe/Moscow
# IMAGE_PREVIEW_ENABLED=true
# MAX_UPLOAD_SIZE_MB=0
# SESSION_LIFETIME_HOURS=12
# SHARE_LINK_TTL_HOURS=24
# LOG_LEVEL=INFO

# Behind HTTPS / reverse proxies
# SECURE_COOKIES=false
# TRUSTED_PROXIES=0
# REAL_IP_HEADER=CF-Connecting-IP

# Brute-force protection
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300
# LOGIN_GLOBAL_MAX_ATTEMPTS=30

# Cloudflare 100 MB upload limit bypass
# DOMAIN=yourdomain.com
# UPLOAD_DOMAIN=upload.yourdomain.com
