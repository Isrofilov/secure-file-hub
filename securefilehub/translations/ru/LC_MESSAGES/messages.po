msgstr "Изменён"

msgid "Select"
msgstr "Выбрать"

msgid "Preview"
msgstr "Просмотр"

msgid "Share link"
msgstr "Ссылка для доступа"

msgid "Download"
msgstr "Скачать"

msgid "No files match your search"
msgstr "Ничего не найдено"

msgid "Clear selection"
msgstr "Снять выделение"

msgid "No files yet"
msgstr "Файлов пока нет"

msgid "Upload your first file"
msgstr "Загрузите первый файл"

msgid "Close"
msgstr "Закрыть"

msgid "Previous"
msgstr "Предыдущий"

msgid "Next"
msgstr "Следующий"

msgid "Copy"
msgstr "Копировать"

#, python-format
msgid "Shown: %(shown)s of %(count)s"
msgstr "Показано: %(shown)s из %(count)s"

#, python-format
msgid "Selected: %(count)s"
msgstr "Выбрано: %(count)s"

#, python-format
msgid "Delete “%(name)s”?"
msgstr "Удалить «%(name)s»?"

#, python-format
msgid "Delete selected files: %(count)s?"
msgstr "Удалить выбранные файлы (%(count)s)?"

msgid "This cannot be undone."
msgstr "Это действие нельзя отменить."

msgid "Delete files"
msgstr "Удаление файлов"

#, python-format
msgid "Anyone with this link can download the file for %(hours)s h. Replacing or deleting the file disables the link."
msgstr "Любой, у кого есть эта ссылка, сможет скачать файл в течение %(hours)s ч. Если файл заменить или удалить, ссылка перестанет работать."

msgid "B"
msgstr "Б"

msgid "KB"
msgstr "КБ"

msgid "MB"
msgstr "МБ"

msgid "GB"
msgstr "ГБ"

msgid "TB"
msgstr "ТБ"

msgid "Showing the first 512 KB"
msgstr "Показаны первые 512 КБ"

msgid "Sign in"
msgstr "Войти"

msgid "Enter the 6-digit code from your authenticator app"
msgstr "Введите 6-значный код из приложения-аутентификатора"

msgid "Enter one of your backup codes. Each code works only once."
msgstr "Введите один из резервных кодов. Каждый код действует только один раз."

msgid "Code"
msgstr "Код"

msgid "Use a backup code"
msgstr "Войти с резервным кодом"

msgid "Use authenticator app"
msgstr "Войти с кодом из приложения"

msgid "Upload files"
msgstr "Загрузка файлов"

#, python-format
msgid "Up to %(size)s per upload"
msgstr "До %(size)s за одну загрузку"

msgid "Any file type, no size limit"
msgstr "Любые типы файлов, без ограничения размера"

msgid "Back to files"
msgstr "К файлам"

msgid "Drop files here or click to choose"
msgstr "Перетащите файлы сюда или нажмите, чтобы выбрать"

msgid "You can also paste files from the clipboard"
msgstr "Файлы также можно вставить из буфера обмена"

msgid "Clear"
msgstr "Очистить"

msgid "Remove"
msgstr "Убрать"

#, python-format
msgid "Selected: %(count)s · %(size)s"
msgstr "Выбрано: %(count)s · %(size)s"

msgid "Waiting"
msgstr "В очереди"

#, python-format
msgid "Uploading… %(percent)s%"
msgstr "Загрузка… %(percent)s%"

msgid "Uploaded"
msgstr "Загружен"

#, python-format
msgid "Saved as %(name)s"
msgstr "Сохранён как %(name)s"

msgid "Failed"
msgstr "Ошибка"

msgid "Canceled"
msgstr "Отменено"

msgid "Too large"
msgstr "Слишком большой"

msgid "All files uploaded"
msgstr "Все файлы загружены"

msgid "Some files were not uploaded"
msgstr "Некоторые файлы не загружены"

msgid "Uploads are still running. Leave the page?"
msgstr "Загрузка ещё идёт. Уйти со страницы?"

msgid "Bad request"
msgstr "Некорректный запрос"

msgid "The request could not be processed. Reload the page and try again."
msgstr "Не удалось обработать запрос. Обновите страницу и попробуйте снова."

msgid "Unauthorized"
msgstr "Требуется вход"

msgid "Sign in to continue."
msgstr "Войдите, чтобы продолжить."

msgid "Access denied"
msgstr "Доступ запрещён"

msgid "You do not have access to this page."
msgstr "У вас нет доступа к этой странице."

msgid "Not found"
msgstr "Не найдено"

msgid "The page or file does not exist. It may have been moved or deleted."
msgstr "Страница или файл не существует. Возможно, его переместили или удалили."

msgid "Method not allowed"
msgstr "Метод не поддерживается"

msgid "This action is not supported here."
msgstr "Это действие здесь не поддерживается."

msgid "Link expired"
msgstr "Ссылка устарела"

msgid "This link is no longer valid. Ask for a new one."
msgstr "Эта ссылка больше не действует. Запросите новую."

msgid "File too large"
msgstr "Файл слишком большой"

msgid "The upload exceeds the allowed size."
msgstr "Загрузка превышает допустимый размер."

msgid "Too many requests"
msgstr "Слишком много запросов"

msgid "Slow down and try again in a moment."
msgstr "Подождите немного и попробуйте снова."

msgid "Server error"
msgstr "Ошибка сервера"

msgid "Something went wrong on the server. Try again later."
msgstr "На сервере что-то пошло не так. Попробуйте позже."

msgid "Error"
msgstr "Ошибка"

msgid "Something went wrong."
msgstr "Что-то пошло не так."

msgid "Enter one of your backup codes"
msgstr "Введите один из резервных кодов"
