#, python-format
msgid "Too many failed attempts. Try again in %(minutes)d min %(seconds)d sec."
msgstr "Слишком много неудачных попыток. Повторите через %(minutes)d мин %(seconds)d сек."

msgid "You signed in with a backup code. Each backup code works only once."
msgstr "Вы вошли с резервным кодом. Каждый резервный код действует только один раз."

msgid "Invalid code"
msgstr "Неверный код"

msgid "You have signed out"
msgstr "Вы вышли из системы"

msgid "No files selected"
msgstr "Файлы не выбраны"

#, python-format
msgid "Deleted %(name)s"
msgstr "Удалён файл %(name)s"

#, python-format
msgid "Files deleted: %(count)d"
msgstr "Удалено файлов: %(count)d"

#, python-format
msgid "Could not delete: %(names)s"
msgstr "Не удалось удалить: %(names)s"

#, python-format
msgid "Files uploaded: %(count)d"
msgstr "Загружено файлов: %(count)d"

